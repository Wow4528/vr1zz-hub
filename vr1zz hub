local function bindRow(title, desc, name, onChange)
    local row = rowBase(keyPage, 46)
    label(row, title, desc)
    local btn = new("TextButton", {
        Parent = row, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.new(0, 120, 0, 26), BackgroundColor3 = FIELD,
        Text = Binds[name], Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = TEXT,
        AutoButtonColor = false,
    }, {corner(6)})
    local function set(v)
        if type(v) ~= "string" then return end
        if name == "Menu" and v == "None" then v = "RightControl" end
        Binds[name] = v
        btn.Text = v
        if name == "AutoClicker" and autoClickInfoLabel then
            autoClickInfoLabel.Text = "Auto clicker key: " .. v .. "  |  Adjust speed above"
        end
        if onChange then onChange() end
    end
    btn.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true
        btn.Text = "press a key..."
        local conn
        conn = UIS.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            conn:Disconnect()
            if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then
                set("None")
            else
                set(input.KeyCode.Name)
            end
            task.defer(function() listening = false end)
        end)
    end)
    register("Bind_" .. name, function() return Binds[name] end, set)
end


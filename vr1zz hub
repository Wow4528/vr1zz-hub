-- one loop drives every scene
do
    local ctx = {t = 0, dt = 0, nx = 0, ny = 0, k = 1, ox = 0, oy = 0, W = W0, H = H0}
    RunService.RenderStepped:Connect(function(dt)
        if not gui.Parent then return end
        local sdt = dt * Anim.Speed
        ctx.t += sdt
        ctx.dt = sdt
        local t = ctx.t

        if Anim.Border then
            strokeGrad.Rotation = (t * 75) % 360
            auraGrad.Rotation = (t * -48) % 360
            auraStroke.Transparency = 0.72 + math.sin(t * 2.1) * 0.08
        end
        wmGrad.Rotation = (t * 25) % 360
        watermark.TextTransparency = Anim.Pulse and (0.86 + math.sin(t * 1.6) * 0.04) or 0.88

        local ap, az = main.AbsolutePosition, main.AbsoluteSize
        local k = (az.X > 0) and (az.X / W0) or 1
        ctx.k, ctx.ox, ctx.oy, ctx.W, ctx.H = k, ap.X, ap.Y, az.X, az.Y
        local shown = main.Visible
        local menuFade = main.GroupTransparency
        local spillOK = shown and az.Y > 300 * k
        local inten = Anim.Intensity / 100

        windowShadow.Visible = shown and spillOK
        if windowShadow.Visible then
            windowShadow.Position = UDim2.fromOffset(ap.X + az.X / 2, ap.Y + az.Y / 2 + 12 * k)
            windowShadow.Size = UDim2.fromOffset(az.X + 70 * k, az.Y + 70 * k)
            windowShadow.ImageTransparency = 0.3 + 0.7 * menuFade
        end

        if shown then
            local mp = UIS:GetMouseLocation()
            local nx = math.clamp((mp.X - ap.X) / math.max(az.X, 1), 0, 1) - 0.5
            local ny = math.clamp((mp.Y - ap.Y) / math.max(az.Y, 1), 0, 1) - 0.5
            local sm = math.clamp(dt * 5, 0, 1)
            ctx.nx += (nx - ctx.nx) * sm
            ctx.ny += (ny - ctx.ny) * sm
            themeMotif.Rotation = math.sin(t * 0.55) * 2
        end
        grade.BackgroundTransparency = 1 - (0.10 + 0.03 * math.sin(t * 0.6)) * inten

        for name, fx in pairs(FX) do
            local target = (name == Theme.Name) and 1 or 0
            fx.vis += (target - fx.vis) * math.clamp(dt * 4, 0, 1)
            local on = shown and fx.vis > 0.01
            fx.inner.Visible = on
            fx.spill.Visible = on and spillOK
            if on then
                fx.inner.GroupTransparency = 1 - fx.vis * inten
                fx.spill.GroupTransparency = 1 - fx.vis * inten * (1 - menuFade)
                fx.update(ctx)
            end
        end
    end)
end


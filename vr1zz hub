-- wind-swayed branching structure (branches, vines, roots)
local function makeTree(parentFrame, spec, color)
    local nodes = spec.nodes
    local depth = {[0] = 0}
    local segs = {}
    for i, n in ipairs(nodes) do
        depth[i] = depth[n.p] + 1
        segs[i] = new("Frame", {
            Parent = parentFrame, AnchorPoint = Vector2.new(0.5, 0.5), BorderSizePixel = 0,
            BackgroundColor3 = color, ZIndex = 2,
        }, {new("UICorner", {CornerRadius = UDim.new(0.5, 0)})})
    end
    local tree = {segs = segs, pos = {}, ang = {}, nodes = nodes}
    function tree.update(ox, oy, k, t, sway)
        local pos, ang = tree.pos, tree.ang
        pos[0] = Vector2.new(ox, oy)
        ang[0] = math.rad(spec.base)
        for i, n in ipairs(nodes) do
            local wob = math.sin(t * spec.speed + depth[i] * 0.8 + i * 0.3) * sway * (0.3 + depth[i] * 0.22)
            local a = ang[n.p] + math.rad(n.rel + wob)
            ang[i] = a
            local d = Vector2.new(math.cos(a), math.sin(a)) * (n.len * k)
            local p0 = pos[n.p]
            pos[i] = p0 + d
            local mid = p0 + d / 2
            local s = segs[i]
            s.Position = UDim2.fromOffset(mid.X, mid.Y)
            s.Size = UDim2.fromOffset(n.len * k + n.th * k * 0.5, math.max(2, n.th * k))
            s.Rotation = math.deg(a)
        end
    end
    return tree
end
local function flipSpec(spec, mirrorX, flipY)
    local base, flip = spec.base, 1
    if mirrorX then base = 180 - base; flip = -flip end
    if flipY then base = -base; flip = -flip end
    local out = {base = base, speed = spec.speed, nodes = {}}
    for i, n in ipairs(spec.nodes) do out.nodes[i] = {p = n.p, len = n.len, rel = n.rel * flip, th = n.th} end
    return out
end


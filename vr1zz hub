-- friend lookups are web calls: do them once per player, never per frame
local function checkFriend(plr)
    task.spawn(function()
        local ok, res = pcall(function() return player:IsFriendsWith(plr.UserId) end)
        ESP.FriendCache[plr.UserId] = (ok and res) and true or false
    end)
end

local function removeESP(plr)
    local d = ESP.Objects[plr]
    if d then
        for _, o in pairs(d) do pcall(function() o:Destroy() end) end
        ESP.Objects[plr] = nil
    end
end

local function createESP(plr)
    removeESP(plr)
    if plr == player then return end
    local char = plr.Character
    if not char then return end
    local root = char:WaitForChild("HumanoidRootPart", 5)
    if not root or not ESP.Enabled then return end

    local hl = new("Highlight", {
        Adornee = char, FillTransparency = 1, OutlineTransparency = 0,
        OutlineColor = ESP.OutlineColor,
        DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, Parent = char,
    })
    local bb = new("BillboardGui", {
        Adornee = char:FindFirstChild("Head") or root,
        Size = UDim2.new(0, 220, 0, 40), StudsOffset = Vector3.new(0, 2.5, 0),
        AlwaysOnTop = true, Parent = char,
    })
    local lbl = new("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, TextColor3 = ESP.TextColor,
        Font = Enum.Font.GothamBold, TextSize = 13, TextStrokeTransparency = 0.4, Text = "", Parent = bb,
    })
    local hpGui = new("BillboardGui", {
        Adornee = root, Size = UDim2.fromOffset(7, 42), StudsOffset = Vector3.new(-2.1, 0, 0),
        AlwaysOnTop = true, Enabled = false, Parent = char,
    })
    local hpBack = new("Frame", {
        Parent = hpGui, Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = Color3.fromRGB(35, 35, 40), BorderSizePixel = 0,
    }, {corner(3)})
    local hpFill = new("Frame", {
        Parent = hpBack, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = GOOD, BorderSizePixel = 0,
    }, {corner(3)})

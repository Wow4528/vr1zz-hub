local open = false
setOpen = function(v)
    open = v
    if v then
        main.Visible = true
        if Anim.OpenAnim then
            tween(main, 0.3, {GroupTransparency = 1 - Settings.UIOpacity / 100})
            tween(scale, 0.35, {Scale = Settings.UIScale / 100}, Enum.EasingStyle.Back)
        else
            main.GroupTransparency = 1 - Settings.UIOpacity / 100; scale.Scale = Settings.UIScale / 100
        end
    else
        if Anim.OpenAnim then
            tween(main, 0.2, {GroupTransparency = 1})
            tween(scale, 0.2, {Scale = 0.85 * Settings.UIScale / 100}).Completed:Connect(function()
                if not open then main.Visible = false end
            end)
        else
            main.GroupTransparency = 1; main.Visible = false
        end
    end
end

UIS.InputBegan:Connect(function(input)
    if unloaded or listening or input.UserInputType ~= Enum.UserInputType.Keyboard or UIS:GetFocusedTextBox() then return end
    local k = input.KeyCode.Name
    if k == Binds.Menu then
        setOpen(not open)
    elseif k == Binds.ESP then
        setMaster(not ESP.Enabled)
    elseif k == Binds.Tracers then
        setTracers(not ESP.Tracers)
    elseif k == Binds.Radar then
        setRadar(not Radar.Enabled)
    elseif k == Binds.Stats then
        Extras.SetStats(not Extras.Stats)
    elseif k == Binds.SpecNext then
        cycleSpectate(1)
    elseif k == Binds.SpecPrev then
        cycleSpectate(-1)
    elseif k == Binds.Panic then
        panicNow()
    elseif k == Binds.Hints then
        hints.Visible = not hints.Visible
        refreshHints()
    elseif Binds.Aimbot ~= "None" and k == Binds.Aimbot then
        Aimbot:KeyDown()
    elseif Binds.Aimlock ~= "None" and k == Binds.Aimlock then
        Aimlock:Key()
    elseif Binds.AutoClicker ~= "None" and k == Binds.AutoClicker then
        setAutoClicker(not autoClickerEnabled)
    end
end)

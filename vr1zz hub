-- auto clicker (uses the executor click helper when it exists, VirtualInputManager otherwise)
local setAutoClicker
do
local autoClickInterval = 0.10
local function sendAutoClick()
    if type(mouse1click) == "function" then
        return pcall(mouse1click)
    end
    local ok, vim = pcall(function() return game:GetService("VirtualInputManager") end)
    if not ok or not vim then return false end
    return pcall(function()
        vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
        vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
    end)
end
setAutoClicker = function(on)
    autoClickerEnabled = on
    if on then
        local supported = type(mouse1click) == "function"
        if not supported then
            local ok, vim = pcall(function() return game:GetService("VirtualInputManager") end)
            supported = ok and vim ~= nil
        end
        if not supported then
            autoClickerEnabled = false
            notify("Auto clicker unavailable: executor blocks simulated clicks", BAD)
            return
        end
        notify("Auto clicker ON  •  " .. Binds.AutoClicker .. " toggles it", GOOD)
    else
        notify("Auto clicker OFF", BAD)
    end
end
section(utilityPage, "Auto Clicker")
toggle(utilityPage, "Auto Clicker", "repeated left-clicks; set a shortcut in Keybinds", false,
    setAutoClicker, "Utility_AutoClicker")
local autoClickCPS = 10
slider(utilityPage, "Clicks Per Second", 1, 30, autoClickCPS, " CPS", function(v)
    autoClickCPS = math.clamp(math.floor(v + 0.5), 1, 30)
    autoClickInterval = 1 / autoClickCPS
    if autoClickInfoLabel then
        autoClickInfoLabel.Text = "Speed: " .. autoClickCPS .. " CPS  |  Key: " .. Binds.AutoClicker
    end
end, "Utility_ClicksPerSecond")

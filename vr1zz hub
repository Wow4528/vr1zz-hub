                    fpsSaved[obj] = true
                    obj.CastShadow = false
                end
            end
            Lighting.GlobalShadows = false
        else
            for obj, old in pairs(fpsSaved) do
                if obj and obj.Parent then
                    pcall(function()
                        if obj:IsA("BasePart") then obj.CastShadow = old else obj.Enabled = old end
                    end)
                end
            end
            table.clear(fpsSaved)

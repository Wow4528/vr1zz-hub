    AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1,
}, {new("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.Name})})

local rebuildList
local function updateSpecStatus()
    specLbl.Text = "Spectating: " .. (spectating and spectating.Name or "nobody")
end

rebuildList = function()
    for _, c in ipairs(listHolder:GetChildren()) do
        if c:IsA("Frame") then c:Destroy() end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then
            local active = (spectating == plr)
            local row = new("Frame", {
                Name = plr.Name, Parent = listHolder, Size = UDim2.new(1, 0, 0, 34),
                BackgroundColor3 = ROW, BackgroundTransparency = 0.16, BorderSizePixel = 0,
            }, {corner(9), new("UIStroke", {Color = ACCENT, Thickness = 1, Transparency = 0.6})})
            new("TextLabel", {
                Parent = row, Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -110, 1, 0),
                BackgroundTransparency = 1, Text = plr.DisplayName .. "  (@" .. plr.Name .. ")",
                Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = TEXT,
                TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
            })
            local btn = new("TextButton", {
                Parent = row, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
                Size = UDim2.new(0, 84, 0, 24), Text = active and "Stop" or "Spectate",
                Font = Enum.Font.GothamBold, TextSize = 12, AutoButtonColor = false,
                TextColor3 = active and Color3.new(1, 1, 1) or ONACCENT,
                BackgroundColor3 = active and BAD or ACCENT,
            }, {corner(6)})
            btn.MouseButton1Click:Connect(function()
                if spectating == plr then stopSpectate() else spectating = plr end
                updateSpecStatus()
                rebuildList()
            end)
        end
    end
end

Players.PlayerAdded:Connect(function() task.wait(0.2); rebuildList() end)
Players.PlayerRemoving:Connect(function(plr)
    if spectating == plr then stopSpectate(); updateSpecStatus() end
    task.defer(rebuildList)
end)
rebuildList()

cycleSpectate = function(dir)
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player then table.insert(list, plr) end
    end
    table.sort(list, function(a, b) return a.Name < b.Name end)
    if #list == 0 then return end
    local idx = table.find(list, spectating) or (dir > 0 and 0 or #list + 1)
    idx = (idx - 1 + dir) % #list + 1
    spectating = list[idx]
    updateSpecStatus()
    rebuildList()
end

-- ===== RADAR PAGE =====
local Radar = {Enabled = false, Size = 150, Range = 300, Color = Color3.fromRGB(255, 60, 60), Team = false}
local setRadar
do
    local frame = new("Frame", {
        Parent = gui, Position = UDim2.new(0, 20, 0, 120), Size = UDim2.fromOffset(Radar.Size, Radar.Size),
        BackgroundColor3 = BG, BackgroundTransparency = 0.25, Visible = false, Active = true,
        ClipsDescendants = true, ZIndex = 0, BorderSizePixel = 0,
    }, {new("UICorner", {CornerRadius = UDim.new(0.5, 0)})})
    new("UIStroke", {Parent = frame, Thickness = 2, Color = ACCENT})
    for _, sz in ipairs({UDim2.new(1, 0, 0, 1), UDim2.new(0, 1, 1, 0)}) do
        new("Frame", {
            Parent = frame, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = sz, BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.85, BorderSizePixel = 0,
        })
    end
    new("Frame", {
        Parent = frame, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.fromOffset(6, 6), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
    }, {corner(3)})

    local dragging, dragStart, startPos
    frame.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging, dragStart, startPos = true, i.Position, frame.Position
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local dots = {}
    local function getDot(plr)
        local d = dots[plr]
        if not d then
            d = new("Frame", {
                Parent = frame, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(6, 6),
                BorderSizePixel = 0,
            }, {corner(3)})
            dots[plr] = d
        end
        return d
    end
    Players.PlayerRemoving:Connect(function(plr)
        if dots[plr] then dots[plr]:Destroy(); dots[plr] = nil end
    end)

    RunService.RenderStepped:Connect(function()
        if not Radar.Enabled then return end
        local cam = workspace.CurrentCamera
        local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not (cam and myRoot) then return end
        local look = cam.CFrame.LookVector
        local f = Vector3.new(look.X, 0, look.Z)
        if f.Magnitude < 0.01 then f = Vector3.new(0, 0, -1) else f = f.Unit end
        local right = f:Cross(Vector3.new(0, 1, 0))
        local radius = Radar.Size / 2
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then
                local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                local dotF = getDot(plr)
                if root then
                    local rel = root.Position - myRoot.Position
                    local v = Vector2.new(rel:Dot(right) / Radar.Range * radius, -rel:Dot(f) / Radar.Range * radius)
                    local edge = v.Magnitude > radius - 5
                    if edge then v = v.Unit * (radius - 5) end
                    dotF.Position = UDim2.fromOffset(radius + v.X, radius + v.Y)
                    dotF.BackgroundTransparency = edge and 0.6 or 0
                    dotF.BackgroundColor3 = Radar.Team and plr.TeamColor.Color or Radar.Color
                    dotF.Visible = true
                else
                    dotF.Visible = false
                end
            end
        end
    end)

    section(radarPage, "Radar")
    setRadar = toggle(radarPage, "Enable Radar", "minimap overlay - drag it to move", false, function(v)
        Radar.Enabled = v
        frame.Visible = v
    end, "Radar_Enabled")
    slider(radarPage, "Radar Size", 100, 250, Radar.Size, "px", function(v)
        Radar.Size = v
        frame.Size = UDim2.fromOffset(v, v)
    end, "Radar_Size")
    slider(radarPage, "Radar Range", 50, 1000, Radar.Range, " studs", function(v) Radar.Range = v end, "Radar_Range")
    colorpicker(radarPage, "Dot Color", Radar.Color, function(c) Radar.Color = c end, "Radar_Color")
    toggle(radarPage, "Use Team Colors", "dots use each player's team color", false, function(v) Radar.Team = v end, "Radar_Team")
end

-- ===== EXTRAS PAGE =====
local Extras = {
    Stats = false, Cross = false, CrossColor = Color3.fromRGB(0, 255, 120),
    CrossSize = 10, CrossThick = 2, CrossGap = 4, CrossStyle = "Classic",
    CrossOutline = true, CrossCenterDot = false, FOVOn = false, FOV = 70,
}
local function buildExtras()
    -- ===== stats overlay: floating pill with live effects =====
    local StatsCfg = {
        FPS = true, Ping = true, Players = true, Clock = true, Session = true,
        Graph = true, Effects = true, Scale = 100, Opacity = 70, Anchor = "Top Middle",
    }
    local YELLOW = Color3.fromRGB(255, 200, 60)

    local statsRoot = new("Frame", {
        Parent = gui, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10),
        Size = UDim2.fromOffset(300, 34), BackgroundTransparency = 1, Visible = false, ZIndex = 0,
    })
    local statsUIScale = new("UIScale", {Parent = statsRoot})
    local glowF = new("Frame", {
        Parent = statsRoot, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(1, 16, 1, 16), BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 0.8, BorderSizePixel = 0, ZIndex = 0,
    }, {corner(24)})
    local glowGrad = new("UIGradient", {Parent = glowF})
    local pill = new("CanvasGroup", {
        Parent = statsRoot, Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = BG,
        BackgroundTransparency = 0.3, BorderSizePixel = 0, ZIndex = 1,
    }, {corner(17)})
    local pillStroke = new("UIStroke", {Parent = pill, Color = Color3.new(1, 1, 1), Thickness = 1.5})
    local pillGrad = new("UIGradient", {Parent = pillStroke})
    table.insert(hooks, function()
        local seq = ColorSequence.new({kp(0, Theme.Accent), kp(0.5, Theme.Accent2), kp(1, Theme.Accent)})
        pillGrad.Color = seq
        glowGrad.Color = seq
    end)
    hooks[#hooks]()

    local shimmer = new("Frame", {
        Parent = pill, Size = UDim2.new(0.3, 0, 1, 0), Position = UDim2.new(-0.3, 0, 0, 0),
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 1,
    })
    new("UIGradient", {Parent = shimmer, Transparency = NSEQ_FADE})

    local statsContent = new("Frame", {
        Parent = pill, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, ZIndex = 2,
    }, {new("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center,
        VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 10),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })})

    local liveDot = new("Frame", {
        Parent = statsContent, LayoutOrder = 1, Size = UDim2.fromOffset(8, 8),
        BackgroundColor3 = GOOD, BorderSizePixel = 0,
    }, {corner(4)})

    local BAR_N = 16
    local graph = new("Frame", {
        Parent = statsContent, LayoutOrder = 2, Size = UDim2.fromOffset(64, 20), BackgroundTransparency = 1,
    })
    local bars, hist = {}, {}
    for i = 1, BAR_N do
        hist[i] = 60
        bars[i] = new("Frame", {
            Parent = graph, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new((i - 1) / BAR_N, 0, 1, 0),
            Size = UDim2.new(1 / BAR_N, -1, 0.5, 0), BackgroundColor3 = GOOD, BorderSizePixel = 0,
        }, {corner(1)})
    end

    local function seg(ord, w)
        return new("TextLabel", {
            Parent = statsContent, LayoutOrder = ord, Size = UDim2.fromOffset(w, 34),
            BackgroundTransparency = 1, RichText = true, Font = Enum.Font.GothamBold, TextSize = 13,
            TextColor3 = TEXT, Text = "", TextXAlignment = Enum.TextXAlignment.Center,
        })
    end
    local fpsLbl, pingLbl = seg(3, 76), seg(4, 84)
    local plrLbl, clockLbl, sessLbl = seg(5, 54), seg(6, 62), seg(7, 72)

    local function layoutStats()
        local items = {
            {liveDot, 8, true}, {graph, 64, StatsCfg.Graph}, {fpsLbl, 76, StatsCfg.FPS},
            {pingLbl, 84, StatsCfg.Ping}, {plrLbl, 54, StatsCfg.Players},
            {clockLbl, 62, StatsCfg.Clock}, {sessLbl, 72, StatsCfg.Session},
        }
        local w, n = 28, 0
        for _, it in ipairs(items) do
            it[1].Visible = it[3]
            if it[3] then w += it[2]; n += 1 end
        end
        w += 10 * math.max(n - 1, 0)
        statsRoot.Size = UDim2.fromOffset(w, 34)
    end

    local ANCHORS = {
        ["Top Middle"]    = {Vector2.new(0.5, 0), UDim2.new(0.5, 0, 0, 10)},
        ["Top Left"]      = {Vector2.new(0, 0),   UDim2.new(0, 12, 0, 12)},
        ["Top Right"]     = {Vector2.new(1, 0),   UDim2.new(1, -12, 0, 12)},
        ["Bottom Middle"] = {Vector2.new(0.5, 1), UDim2.new(0.5, 0, 1, -12)},
    }
    local function applyAnchor()
        local a = ANCHORS[StatsCfg.Anchor] or ANCHORS["Top Middle"]
        statsRoot.AnchorPoint = a[1]
        statsRoot.Position = a[2]
    end

    local function hex(c)
        return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
    end
    local function fpsCol(f) return f >= 55 and GOOD or (f >= 30 and YELLOW or BAD) end
    local function pingCol(p) return p <= 80 and GOOD or (p <= 150 and YELLOW or BAD) end
    local function fmtTime(sec)
        sec = math.floor(sec)
        local h, m, sc = sec // 3600, (sec % 3600) // 60, sec % 60
        if h > 0 then return string.format("%d:%02d:%02d", h, m, sc) end
        return string.format("%02d:%02d", m, sc)
    end

    -- crosshair
    local cross = new("Frame", {
        Parent = gui, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1, Visible = false, ZIndex = 0,
    })
    local arms = {}
    for i = 1, 4 do
        arms[i] = new("Frame", {
            Parent = cross, AnchorPoint = Vector2.new(0.5, 0.5),
            BorderSizePixel = 0, BackgroundColor3 = Extras.CrossColor,
        })
        new("UICorner", {Parent = arms[i], CornerRadius = UDim.new(0, 2)})
        new("UIStroke", {Parent = arms[i], Name = "CrossOutline", Color = Color3.new(0, 0, 0), Thickness = 1, Enabled = Extras.CrossOutline})
    end
    local centerDot = new("Frame", {
        Parent = cross, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, 0),
        Size = UDim2.fromOffset(3, 3), BackgroundColor3 = Extras.CrossColor,
        BorderSizePixel = 0, Visible = Extras.CrossCenterDot,
    }, {corner(8), new("UIStroke", {Name = "CrossOutline", Color = Color3.new(0, 0, 0), Thickness = 1, Enabled = Extras.CrossOutline})})
    local ring = new("Frame", {
        Parent = cross, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, 0),
        Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 1, Visible = false,
    }, {corner(20), new("UIStroke", {Name = "CrossOutline", Color = Color3.new(0, 0, 0), Thickness = 1, Enabled = Extras.CrossOutline})})
    local ringStroke = ring:FindFirstChildOfClass("UIStroke")
    local function updateCross()
        local sz, th = Extras.CrossSize, Extras.CrossThick
        local off = Extras.CrossGap + sz / 2
        local style = Extras.CrossStyle or "Classic"
        local positions = {
            UDim2.fromOffset(0, -off), UDim2.fromOffset(0, off),
            UDim2.fromOffset(-off, 0), UDim2.fromOffset(off, 0),
        }
        local sizes = {
            UDim2.fromOffset(th, sz), UDim2.fromOffset(th, sz),
            UDim2.fromOffset(sz, th), UDim2.fromOffset(sz, th),
        }
        for i, arm in ipairs(arms) do
            arm.Position = positions[i]
            arm.Size = sizes[i]
            arm.BackgroundColor3 = Extras.CrossColor
            local st = arm:FindFirstChild("CrossOutline")
            if st then st.Enabled = Extras.CrossOutline end
            arm.Visible = (style == "Classic" or style == "T") and (style ~= "T" or i ~= 2)
        end
        if style == "Dot" then
            for _, arm in ipairs(arms) do arm.Visible = false end
            centerDot.Visible = true
        else
            centerDot.Visible = Extras.CrossCenterDot
        end
        ring.Visible = style == "Circle"
        ring.Size = UDim2.fromOffset(math.max(10, sz + Extras.CrossGap * 2), math.max(10, sz + Extras.CrossGap * 2))
        ringStroke.Color = Extras.CrossColor
        ringStroke.Thickness = th
        ringStroke.Enabled = Extras.CrossOutline
        centerDot.BackgroundColor3 = Extras.CrossColor
        local dotStroke = centerDot:FindFirstChild("CrossOutline")
        if dotStroke then dotStroke.Enabled = Extras.CrossOutline end
    end
    updateCross()

    local frames, acc, fxT, origFOV, sessionStart = 0, 0, 0, nil, os.clock()
    RunService.RenderStepped:Connect(function(dt)
        if not gui.Parent then return end
        frames += 1
        acc += dt
        fxT += dt
        if Extras.Stats and StatsCfg.Effects then
            pillGrad.Rotation = (fxT * 90) % 360
            glowGrad.Rotation = (-fxT * 40) % 360
            glowF.BackgroundTransparency = 0.78 + math.sin(fxT * 2) * 0.06
            shimmer.Position = UDim2.new(((fxT * 0.4) % 1.6) - 0.3, 0, 0, 0)
            liveDot.BackgroundTransparency = 0.25 + (math.sin(fxT * 4) + 1) * 0.25
        end
        if acc >= 0.25 then
            local fps = math.floor(frames / acc + 0.5)
            if Extras.Stats then
                local ping = 0
                pcall(function() ping = math.floor(player:GetNetworkPing() * 1000) end)
                local ac = hex(Theme.Accent)
                fpsLbl.Text = string.format('<font color="%s">FPS</font> <font color="%s">%d</font>', ac, hex(fpsCol(fps)), fps)
                pingLbl.Text = string.format('<font color="%s">PING</font> <font color="%s">%dms</font>', ac, hex(pingCol(ping)), ping)
                plrLbl.Text = "👥 " .. #Players:GetPlayers()
                clockLbl.Text = "🕒 " .. os.date("%H:%M")
                sessLbl.Text = "⏱ " .. fmtTime(os.clock() - sessionStart)
                table.remove(hist, 1)
                table.insert(hist, fps)
                for i, b in ipairs(bars) do
                    b.Size = UDim2.new(1 / BAR_N, -1, math.clamp(hist[i] / 90, 0.12, 1), 0)
                    b.BackgroundColor3 = fpsCol(hist[i])
                end
            end
            frames, acc = 0, 0
        end
        if Extras.FOVOn then
            local cam = workspace.CurrentCamera
            if cam then cam.FieldOfView = Extras.FOV end
        end
    end)

    section(extrasPage, "Stats Overlay")
    Extras.SetStats = toggle(extrasPage, "Stats Overlay", "floating pill with FPS, ping, clock and more", false, function(v)
        Extras.Stats = v
        statsRoot.Visible = v
    end, "Extras_Stats")
    cycle(extrasPage, "Stats Position", "where the pill sits on screen",
        {"Top Middle", "Top Left", "Top Right", "Bottom Middle"}, StatsCfg.Anchor,
        function(v) StatsCfg.Anchor = v; applyAnchor() end, "Stats_Anchor")
    toggle(extrasPage, "Show FPS", nil, true, function(v) StatsCfg.FPS = v; layoutStats() end, "Stats_FPS")
    toggle(extrasPage, "Show Ping", nil, true, function(v) StatsCfg.Ping = v; layoutStats() end, "Stats_Ping")
    toggle(extrasPage, "Show Player Count", nil, true, function(v) StatsCfg.Players = v; layoutStats() end, "Stats_Players")
    toggle(extrasPage, "Show Clock", nil, true, function(v) StatsCfg.Clock = v; layoutStats() end, "Stats_Clock")
    toggle(extrasPage, "Show Session Timer", nil, true, function(v) StatsCfg.Session = v; layoutStats() end, "Stats_Session")
    toggle(extrasPage, "Show FPS Graph", "mini live graph of your framerate", true, function(v) StatsCfg.Graph = v; layoutStats() end, "Stats_Graph")
    toggle(extrasPage, "Pill Effects", "glow, shimmer, rotating border, live dot", true, function(v)
        StatsCfg.Effects = v
        glowF.Visible = v
        shimmer.Visible = v
        liveDot.BackgroundTransparency = 0
    end, "Stats_Effects")
    slider(extrasPage, "Stats Scale", 70, 150, StatsCfg.Scale, "%", function(v)
        StatsCfg.Scale = v
        statsUIScale.Scale = v / 100
    end, "Stats_Scale")
    slider(extrasPage, "Stats Background Opacity", 0, 100, StatsCfg.Opacity, "%", function(v)
        StatsCfg.Opacity = v
        pill.BackgroundTransparency = 1 - v / 100
    end, "Stats_Opacity")
    layoutStats()
    applyAnchor()

    section(extrasPage, "Crosshair")
    toggle(extrasPage, "Crosshair", "custom crosshair at screen center", false, function(v)
        Extras.Cross = v
        cross.Visible = v
    end, "Extras_Cross")
    colorpicker(extrasPage, "Crosshair Color", Extras.CrossColor, function(c) Extras.CrossColor = c; updateCross() end, "Extras_CrossColor")
    slider(extrasPage, "Crosshair Size", 4, 30, Extras.CrossSize, "px", function(v) Extras.CrossSize = v; updateCross() end, "Extras_CrossSize")
    slider(extrasPage, "Crosshair Thickness", 1, 4, Extras.CrossThick, "px", function(v) Extras.CrossThick = v; updateCross() end, "Extras_CrossThick")
    slider(extrasPage, "Crosshair Gap", 0, 12, Extras.CrossGap, "px", function(v) Extras.CrossGap = v; updateCross() end, "Extras_CrossGap")
    cycle(extrasPage, "Crosshair Style", "Classic, T, dot, or circle", {"Classic", "T", "Dot", "Circle"}, Extras.CrossStyle, function(v)
        Extras.CrossStyle = v
        updateCross()
    end, "Extras_CrossStyle")
    toggle(extrasPage, "Crosshair Outline", "black edge to keep it visible", Extras.CrossOutline, function(v)
        Extras.CrossOutline = v
        updateCross()
    end, "Extras_CrossOutline")
    toggle(extrasPage, "Center Dot", "show a small dot in the middle", Extras.CrossCenterDot, function(v)
        Extras.CrossCenterDot = v
        updateCross()
    end, "Extras_CrossCenterDot")

    section(extrasPage, "Camera")
    toggle(extrasPage, "Custom FOV", "override the camera field of view", false, function(v)
        local cam = workspace.CurrentCamera
        if v then
            origFOV = cam and cam.FieldOfView or 70
            Extras.OrigFOV = origFOV
        elseif cam and origFOV then
            cam.FieldOfView = origFOV
        end
        Extras.FOVOn = v
    end, "Extras_FOVOn")
    slider(extrasPage, "Field of View", 30, 120, Extras.FOV, "°", function(v) Extras.FOV = v end, "Extras_FOV")

    section(extrasPage, "Utilities")
    button(extrasPage, "Rejoin Server", "reconnects you to this same server", "Rejoin", function()
        pcall(function()
            game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, game.JobId, player)
        end)
    end)
end

buildExtras()


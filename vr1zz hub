                obj = new("TextLabel", {Parent = spill, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(sz, sz),
                    BackgroundTransparency = 1, Text = "▲", Font = Enum.Font.GothamBold, TextSize = sz,
                    TextColor3 = Color3.fromRGB(170, 30, 62), ZIndex = 3})}
        end
        for _, idx in ipairs({6, 10}) do
            roses[#roses + 1] = {idx = idx, obj = new("TextLabel", {Parent = spill, AnchorPoint = Vector2.new(0.5, 0.5),
                Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1, Text = "❀", Font = Enum.Font.GothamBlack,
                TextSize = 22, TextColor3 = Color3.fromRGB(205, 36, 76), TextStrokeTransparency = 0.6, ZIndex = 4})}
        end
        vines[#vines + 1] = {tree = tree, ax = v.ax, ay = v.ay, thorns = thorns, roses = roses}
    end
    local bats = {}
    for i = 1, 3 do
        bats[i] = {ph = i * 2.1, sp = 0.3 + i * 0.07, ry = 0.55 + i * 0.12,
            obj = new("TextLabel", {Parent = spill, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(24, 24),
                BackgroundTransparency = 1, Text = "🦇", Font = Enum.Font.GothamBold, TextSize = 22,
                TextColor3 = Color3.new(1, 1, 1), ZIndex = 5})}
    end

    FX.Gothic = {inner = inner, spill = spill, vis = 0, particles = {pFolder}, update = function(ctx)
        local t, k = ctx.t, ctx.k
        rose.Position = UDim2.new(0.76, ctx.nx * -16, 0.5, ctx.ny * -12)
        rose.Rotation = (t * 3.2) % 360
        crossG.Rotation = -rose.Rotation
        crossG.TextTransparency = 0.3 + 0.12 * math.sin(t * 1.4)
        for i, f in ipairs(fogs) do
            f.Position = UDim2.new(((t * 0.014 * (i % 2 == 0 and -1 or 1) + i * 0.37) % 1.5) - 0.25, 0, 0.35 + i * 0.17, 0)
        end
        local flick = 1 + 0.08 * math.sin(t * 13) + 0.05 * math.sin(t * 7.3 + 1) + 0.03 * math.sin(t * 23)
        candleL.Size = UDim2.fromOffset(190 * flick, 190 * flick)
        candleR.Size = UDim2.fromOffset(190 * (2 - flick), 190 * (2 - flick))
        if Anim.Particles then
            for _, e in ipairs(embers) do
                e.y -= e.sp * ctx.dt
                if e.y < -0.05 then e.y = 1.05; e.x = math.random() end
                e.obj.Position = UDim2.new(e.x + math.sin(t + e.ph) * 0.01, 0, e.y, 0)
                e.obj.BackgroundTransparency = 0.2 + 0.6 * (0.5 + 0.5 * math.sin(t * 5 + e.ph))
            end
        end
        for _, v in ipairs(vines) do
            v.tree.update(ctx.ox + v.ax * ctx.W + ((v.ax == 0) and 12 or -12) * k,
                ctx.oy + v.ay * ctx.H + ((v.ay == 0) and 12 or -12) * k, k, t, 4)
            local pos, ang, nodes = v.tree.pos, v.tree.ang, v.tree.nodes
            for _, th in ipairs(v.thorns) do
                local n = nodes[th.idx]
                local mid = (pos[n.p] + pos[th.idx]) / 2
                local a = ang[th.idx]
                local na = a + th.side * math.pi / 2
                local off = (n.th * 0.55 + 3) * k
                th.obj.Position = UDim2.fromOffset(mid.X + math.cos(na) * off, mid.Y + math.sin(na) * off)
                th.obj.Rotation = math.deg(na) + 90
                local sz = math.clamp(math.floor(th.size * k), 5, 30)
                th.obj.Size = UDim2.fromOffset(sz, sz); th.obj.TextSize = sz
            end
            for _, r in ipairs(v.roses) do
                local p = pos[r.idx]
                local sz = math.clamp(math.floor(22 * k), 8, 40)
                r.obj.Position = UDim2.fromOffset(p.X, p.Y)
                r.obj.Size = UDim2.fromOffset(sz, sz); r.obj.TextSize = sz
                r.obj.Rotation = math.sin(t + r.idx) * 12
            end
        end
        for _, b in ipairs(bats) do
            local a = t * b.sp + b.ph
            local sz = math.clamp(math.floor((22 + 6 * math.sin(t * 9 + b.ph)) * k), 8, 50)
            b.obj.Position = UDim2.fromOffset(ctx.ox + ctx.W / 2 + math.cos(a) * (ctx.W / 2 + 95 * k),
                ctx.oy + ctx.H / 2 + math.sin(a * 1.3) * (ctx.H / 2 * b.ry + 70 * k))
            b.obj.Size = UDim2.fromOffset(sz, sz); b.obj.TextSize = sz
            b.obj.Rotation = math.sin(t * 3 + b.ph) * 14
        end
    end}
end


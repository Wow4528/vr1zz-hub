local Pal = {}
for k, v in pairs(ThemePalette.Original) do Pal[k] = v end

local function lum(c) return 0.299 * c.R + 0.587 * c.G + 0.114 * c.B end
local function refreshOnAccent()
    Pal.onaccent = (lum(Theme.Accent) > 0.55) and Color3.fromRGB(14, 14, 18) or Color3.new(1, 1, 1)
end
refreshOnAccent()

local function C(role)
    if role == "accent" then return Theme.Accent end
    if role == "accent2" then return Theme.Accent2 end
    return Pal[role]
end
local function R(role) return {__role = role} end
local BG, PANEL, ROW, FIELD, OFF = R"bg", R"panel", R"row", R"field", R"off"
local TEXT, SUBTEXT, ONACCENT, ACCENT, ACCENT2 = R"text", R"sub", R"onaccent", R"accent", R"accent2"
local GOOD = Color3.fromRGB(70, 210, 120)
local BAD  = Color3.fromRGB(235, 70, 80)

local Anim = {Particles = true, Border = true, Pulse = true, OpenAnim = true, Speed = 1, Intensity = 100}

local bindings = setmetatable({}, {__mode = "k"})
local function bindRole(obj, prop, role)
    local b = bindings[obj]
    if not b then b = {}; bindings[obj] = b end
    b[prop] = role
    obj[prop] = C(role)
end

local hooks = {}
local function applyTheme()
    refreshOnAccent()
    for obj, props in pairs(bindings) do
        if obj.Parent then
            for prop, role in pairs(props) do
                pcall(function() obj[prop] = C(role) end)
            end
        end
    end
    for _, h in ipairs(hooks) do pcall(h) end
end
local function themed(obj, prop, which)
    bindRole(obj, prop, (which == "Accent2") and "accent2" or "accent")
end


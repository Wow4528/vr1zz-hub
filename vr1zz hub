local PETAL_COLORS = {
    Color3.fromRGB(255, 170, 205), Color3.fromRGB(255, 196, 220),
    Color3.fromRGB(255, 140, 184), Color3.fromRGB(255, 222, 235),
}
local function makePetals(parent, n, x0, x1, y0, y1)
    local list = {region = {x0, x1, y0, y1}}
    for i = 1, n do
        local w = math.random(8, 14)
        list[i] = {
            obj = new("Frame", {
                Parent = parent, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(w, w * 0.6),
                BackgroundColor3 = PETAL_COLORS[math.random(#PETAL_COLORS)],
                BackgroundTransparency = math.random(5, 30) / 100, BorderSizePixel = 0,
            }, {new("UICorner", {CornerRadius = UDim.new(0.5, 0)})}),
            w = w, x = math.random(x0, x1), y = math.random(y0, y1), sp = math.random(16, 36),
            dr = math.random(-8, 8), sw = math.random(8, 16) / 10, ph = math.random() * 6.28,
            spin = math.random(-70, 70),
        }
    end
    return list
end
local function updatePetals(list, ctx, ox, oy, k, par)
    local x0, x1, y0, y1 = list.region[1], list.region[2], list.region[3], list.region[4]
    for _, p in ipairs(list) do
        p.y += p.sp * ctx.dt
        p.x += p.dr * ctx.dt
        if p.y > y1 or p.x < x0 - 40 or p.x > x1 + 40 then p.y = y0; p.x = math.random(x0, x1) end
        local sx = p.x + math.sin(ctx.t * p.sw + p.ph) * 26
        p.obj.Position = UDim2.fromOffset(ox + sx * k + ctx.nx * par, oy + p.y * k + ctx.ny * par)
        p.obj.Rotation = ctx.t * p.spin + p.ph * 40
        p.obj.Size = UDim2.fromOffset(p.w * k, p.w * 0.6 * k * (0.35 + 0.65 * math.abs(math.sin(ctx.t * 1.7 + p.ph))))
    end
end


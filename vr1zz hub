local unloaded = false
local applyMenuLook
local queueExec
do
    queueExec = function(quiet)
        if not Settings.AutoExec then
            if not quiet then notify("Turn on Auto Execute first", BAD) end
            return
        end
        local qot = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
        if not qot then
            if not quiet then notify("Your executor has no queue_on_teleport", BAD) end
            return
        end
        local url = string.gsub(Settings.ScriptURL or "", '["\\\n]', "")
        if url == "" then
            if not quiet then notify("Paste your script URL first", BAD) end
            return
        end
        local ok = pcall(qot, 'loadstring(game:HttpGet("' .. url .. '"))()')
        if not quiet then
            notify(ok and "Queued - hub will auto-run after teleport / rejoin" or "Queue failed", ok and GOOD or BAD)
        end
    end
    player.OnTeleport:Connect(function() queueExec(true) end)

    section(settingsPage, "Startup")
    toggle(settingsPage, "Auto Load Config", "load your saved config on start (press Save in Config after changing)", true,
        function(v) Settings.AutoLoad = v end, "Set_AutoLoad")
    toggle(settingsPage, "Auto Enable ESP", "turn ESP on automatically when the hub starts", false,
        function(v) Settings.AutoESP = v end, "Set_AutoESP")
    toggle(settingsPage, "Open Menu on Start", "off = hub starts hidden, use your menu key", true,
        function(v) Settings.OpenOnStart = v end, "Set_OpenOnStart")

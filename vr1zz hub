    })
    ESP.Objects[plr] = {Highlight = hl, Billboard = bb, Label = lbl, Tracer = line,
        HealthGui = hpGui, HealthFill = hpFill}
end

local function refreshAll()
    for plr in pairs(ESP.Objects) do removeESP(plr) end
    if not ESP.Enabled then return end
    for _, plr in ipairs(Players:GetPlayers()) do task.spawn(createESP, plr) end
end

local function hookPlayer(plr)
    checkFriend(plr)
    plr.CharacterAdded:Connect(function()
        if ESP.Enabled then createESP(plr) end
    end)
    plr.CharacterRemoving:Connect(function() removeESP(plr) end)
end
for _, plr in ipairs(Players:GetPlayers()) do hookPlayer(plr) end
Players.PlayerAdded:Connect(hookPlayer)
Players.PlayerRemoving:Connect(removeESP)

RunService.RenderStepped:Connect(function()
    if not ESP.Enabled then return end
    local cam = workspace.CurrentCamera
    local myChar = player.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    for plr, d in pairs(ESP.Objects) do
        local char = plr.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if root and hum and myRoot and cam then
            local dist = (root.Position - myRoot.Position).Magnitude
            local visible = dist <= ESP.MaxDistance
            if ESP.TeamCheck and plr.Team ~= nil and plr.Team == player.Team then visible = false end

            local teamCol = plr.TeamColor.Color
            d.Highlight.Enabled = visible and (ESP.Highlight or ESP.Fill)
            d.Highlight.OutlineTransparency = ESP.Highlight and 0 or 1
            d.Highlight.FillTransparency = ESP.Fill and (ESP.FillTransp / 100) or 1
            d.Highlight.FillColor = ESP.TeamColor and teamCol or ESP.FillColor
            d.Billboard.Enabled = visible and ESP.Info
            d.HealthGui.Enabled = visible and ESP.HealthBars
            if visible then
                d.Label.Text = string.format("%s | %s | %dm | %d/%d HP",
                    plr.Name, plr.Team and plr.Team.Name or "No Team",
                    math.floor(dist), math.floor(hum.Health), math.floor(hum.MaxHealth))
                local friend = ESP.FriendsHighlight and ESP.FriendCache[plr.UserId]
                d.Highlight.OutlineColor = friend and Color3.fromRGB(70, 190, 255)
                    or (ESP.TeamColor and teamCol or ESP.OutlineColor)
                d.Label.TextColor3 = friend and Color3.fromRGB(70, 190, 255)
                    or (ESP.TeamColor and teamCol or ESP.TextColor)
                local ratio = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
                d.HealthFill.Size = UDim2.new(1, 0, ratio, 0)
                d.HealthFill.BackgroundColor3 = Color3.fromRGB(235 * (1 - ratio), 210 * ratio, 75)
            end

            local line = d.Tracer
            if ESP.Tracers and visible then
                local sp, on = cam:WorldToViewportPoint(root.Position)
                if on then
                    local vs = cam.ViewportSize
                    local origin
                    if ESP.TracerOrigin == "Center" then origin = vs / 2
                    elseif ESP.TracerOrigin == "Mouse" then origin = UIS:GetMouseLocation()
                    else origin = Vector2.new(vs.X / 2, vs.Y) end
                    local target = Vector2.new(sp.X, sp.Y)
                    local delta = target - origin
                    local mid = origin + delta / 2
                    line.Size = UDim2.fromOffset(delta.Magnitude, ESP.TracerThickness)
                    line.Position = UDim2.fromOffset(mid.X, mid.Y)
                    line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
                    line.BackgroundColor3 = ESP.TeamColor and teamCol or ESP.TracerColor
                    line.Visible = true
                else
                    line.Visible = false
                end
            else
                line.Visible = false
            end
        else
            d.Tracer.Visible = false
        end
    end
end)


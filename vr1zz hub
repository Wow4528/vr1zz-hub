----------------------------------------------------------------
-- COMBAT  •  camera aimbot + hard aimlock
-- Both are pure client-side camera writes. The aimbot is bound at
-- Camera + 1 and the aimlock at Camera + 2, so a lock always wins.
----------------------------------------------------------------
local Aimbot = {
    Armed = false, Holding = false,
    Mode = "Hold", FOV = 250, Smooth = 45, MaxDistance = 600,
    TeamCheck = true, WallCheck = true, Prediction = 0,
    Hitbox = "Head", AutoShoot = false, ShowFOV = true,
    FOVColor = Theme.Accent, Thickness = 2,
    Target = nil, Toggle = nil,
}
local Aimlock = {
    Armed = false, Locked = nil, Holding = false, LastClick = 0, Toggle = nil, Release = nil,
    Part = "Head", LockFOV = 100, TriggerFOV = 16, TriggerDelay = 70,
    Prediction = 12, Smooth = 35, Trigger = false, WallCheck = false, NoRecoil = false,
    ShowFOV = true, FOVColor = Theme.Accent2, Thickness = 2,
}

do
    local aimLayer = new("Frame", {
        Parent = gui, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        BorderSizePixel = 0, ZIndex = 0,
    })
    local aimRing = new("Frame", {
        Parent = aimLayer, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.fromOffset(500, 500), BackgroundTransparency = 1, Visible = false, ZIndex = 0,
    }, {new("UICorner", {CornerRadius = UDim.new(0.5, 0)})})
    local aimRingStroke = new("UIStroke", {Parent = aimRing, Thickness = 2, Transparency = 0.25})
    local aimDot = new("Frame", {
        Parent = aimLayer, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.fromOffset(5, 5), BackgroundTransparency = 0.35, BorderSizePixel = 0, Visible = false,
    }, {corner(3)})

    local lockLayer = new("Frame", {
        Parent = gui, Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
        BorderSizePixel = 0, ZIndex = 0,
    })
    local lockRing = new("Frame", {
        Parent = lockLayer, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.fromOffset(200, 200), BackgroundTransparency = 1, Visible = false, ZIndex = 0,
    }, {new("UICorner", {CornerRadius = UDim.new(0.5, 0)})})
    local lockRingStroke = new("UIStroke", {
        Parent = lockRing, Thickness = 2, Transparency = 0.3, Color = Aimlock.FOVColor,
    })

    -- single left click (executor helper first, VirtualInputManager otherwise)
    local function clickOnce()
        if type(mouse1click) == "function" then return pcall(mouse1click) end
        local ok, vim = pcall(function() return game:GetService("VirtualInputManager") end)
        if not ok or not vim then return false end
        return pcall(function()
            vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end)
    end

    ----------------------------------------------------------------
    -- aimbot internals
    ----------------------------------------------------------------
    local HITBOX = {Head = "Head", Torso = "HumanoidRootPart"}
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude

    local function partsOf(char)
        if not char then return {} end
        if Aimbot.Hitbox == "Nearest" then
            local out = {}
            local h, r = char:FindFirstChild("Head"), char:FindFirstChild("HumanoidRootPart")
            if h then table.insert(out, h) end
            if r then table.insert(out, r) end
            return out
        end
        local part = char:FindFirstChild(HITBOX[Aimbot.Hitbox] or "Head")
        return part and {part} or {}
    end

    local function toScreen(pos)
        local sp, on = workspace.CurrentCamera:WorldToViewportPoint(pos)
        if not on or sp.Z <= 0 then return nil end
        return Vector2.new(sp.X, sp.Y)
    end

    local function visible(part)
        if not Aimbot.WallCheck then return true end
        local cam = workspace.CurrentCamera
        local filters = {part.Parent, cam}
        if player.Character then table.insert(filters, player.Character) end
        rayParams.FilterDescendantsInstances = filters
        local hit = workspace:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, rayParams)
        return hit == nil or hit.Instance:IsDescendantOf(part.Parent)
    end

    local function eligible(plr)
        if plr == player then return false end
        if Aimbot.TeamCheck and plr.Team ~= nil and plr.Team == player.Team then return false end
        local char = plr.Character
        if not char then return false end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return false end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return false end
        return (root.Position - workspace.CurrentCamera.CFrame.Position).Magnitude <= Aimbot.MaxDistance
    end

    local function pickTarget(center)
        local best, bestDist, bestPart = nil, Aimbot.FOV, nil
        for _, plr in ipairs(Players:GetPlayers()) do
            if eligible(plr) then
                for _, part in ipairs(partsOf(plr.Character)) do
                    local sp = toScreen(part.Position)
                    if sp then
                        local d = (sp - center).Magnitude
                        if d < bestDist and visible(part) then
                            best, bestDist, bestPart = plr, d, part
                        end
                    end
                end
            end
        end
        return best, bestPart
    end

    local function isActive()
        if not Aimbot.Armed then return false end
        if Aimbot.Mode == "Hold" then return Aimbot.Holding end
        return true
    end

    local shootAcc = 0

    RunService:BindToRenderStep("VR1ZZ_Aimbot", Enum.RenderPriority.Camera.Value + 1, function(dt)
        if not gui.Parent then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local center = cam.ViewportSize / 2

        aimRing.Visible = Aimbot.Armed and Aimbot.ShowFOV
        if aimRing.Visible then
            aimRing.Position = UDim2.fromOffset(center.X, center.Y)
            aimRing.Size = UDim2.fromOffset(Aimbot.FOV * 2, Aimbot.FOV * 2)
            aimRingStroke.Color = Aimbot.FOVColor
            aimRingStroke.Thickness = Aimbot.Thickness
        end

        if not (isActive() and not spectating and not UIS:GetFocusedTextBox()) then
            Aimbot.Target = nil
            aimDot.Visible = false
            aimRingStroke.Transparency = 0.25
            return
        end

        local target, part = pickTarget(center)
        Aimbot.Target = target
        aimDot.Visible = target ~= nil
        aimRingStroke.Transparency = target and 0 or 0.25
        if not (target and part) then return end

        aimDot.Position = UDim2.fromOffset(center.X, center.Y)
        aimDot.BackgroundColor3 = Aimbot.FOVColor
        local goalPos = part.Position
        if Aimbot.Prediction > 0 then
            goalPos += part.AssemblyLinearVelocity * (Aimbot.Prediction / 1000)
        end
        local goal = CFrame.lookAt(cam.CFrame.Position, goalPos)
        local alpha = 1 - math.exp(-dt * (1 + (100 - Aimbot.Smooth) * 0.9))
        cam.CFrame = cam.CFrame:Lerp(goal, math.clamp(alpha, 0, 1))

        if Aimbot.AutoShoot then
            shootAcc += dt
            if shootAcc >= 1 / 12 then
                shootAcc = 0
                clickOnce()
            end
        end
    end)

    function Aimbot:Set(on, quiet)
        self.Armed = on and true or false
        if not self.Armed then
            self.Holding = false
            self.Target = nil
        end
        if not quiet then
            notify(self.Armed and "Aimbot armed" or "Aimbot disarmed", self.Armed and GOOD or BAD)
        end
    end

    function Aimbot:KeyDown()
        if self.Mode == "Hold" then
            self.Holding = true
        elseif self.Toggle then
            self.Toggle(not self.Armed)
        end
    end

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Keyboard
            and Binds.Aimbot ~= "None" and input.KeyCode.Name == Binds.Aimbot then
            Aimbot.Holding = false
        end
    end)

    ----------------------------------------------------------------
    -- aimlock internals
    ----------------------------------------------------------------
    local lockRay = RaycastParams.new()
    lockRay.FilterType = Enum.RaycastFilterType.Exclude

    local function lockPart(char)
        if Aimlock.Part == "Head" then
            return char:FindFirstChild("Head")
        elseif Aimlock.Part == "Torso" then
            return char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
                or char:FindFirstChild("HumanoidRootPart")
        end
        return char:FindFirstChild("HumanoidRootPart")
    end

    local function lockVisible(part)
        if not Aimlock.WallCheck then return true end
        local cam = workspace.CurrentCamera
        local filters = {cam}
        if player.Character then table.insert(filters, player.Character) end
        lockRay.FilterDescendantsInstances = filters
        local hit = workspace:Raycast(cam.CFrame.Position, part.Position - cam.CFrame.Position, lockRay)
        return hit == nil or (hit.Instance and hit.Instance:IsDescendantOf(part.Parent))
    end

    local function lockCandidate()
        local mousePos = UIS:GetMouseLocation()
        local cam = workspace.CurrentCamera
        local best, bestDist = nil, Aimlock.LockFOV
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player then
                local char = plr.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local part = lockPart(char)
                    if part then
                        local sp, on = cam:WorldToViewportPoint(part.Position)
                        if on and sp.Z > 0 then
                            local d = (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude
                            if d < bestDist and lockVisible(part) then best, bestDist = part, d end
                        end
                    end
                end
            end
        end
        return best
    end

    local function pressDown()
        if Aimlock.Holding then return end
        local ok, vim = pcall(function() return game:GetService("VirtualInputManager") end)
        if ok and vim then
            Aimlock.Holding = true
            local pos = UIS:GetMouseLocation()
            pcall(function() vim:SendMouseButtonEvent(pos.X, pos.Y, 0, true, game, 1) end)
        else
            clickOnce()
        end
    end
    local function pressUp()
        if not Aimlock.Holding then return end
        Aimlock.Holding = false
        local ok, vim = pcall(function() return game:GetService("VirtualInputManager") end)
        if ok and vim then
            local pos = UIS:GetMouseLocation()
            pcall(function() vim:SendMouseButtonEvent(pos.X, pos.Y, 0, false, game, 1) end)
        end
    end
    Aimlock.Release = pressUp

    ----------------------------------------------------------------
    -- aimbot UI
    ----------------------------------------------------------------
    section(aimPage, "Aimbot  •  camera assist")
    Aimbot.Toggle = toggle(aimPage, "Enable Aimbot", "arms the assist - set a keybind below", false,
        function(v) Aimbot:Set(v) end, "Aimbot_Armed")
    cycle(aimPage, "Activation", "Hold = aim while held  |  Toggle = press to arm", {"Hold", "Toggle"},
        Aimbot.Mode, function(v) Aimbot.Mode = v; Aimbot.Holding = false end, "Aimbot_Mode")
    cycle(aimPage, "Target Part", "Head = headshots  |  Torso = body  |  Nearest = closest to crosshair",
        {"Head", "Torso", "Nearest"}, Aimbot.Hitbox, function(v) Aimbot.Hitbox = v end, "Aimbot_Hitbox")
    slider(aimPage, "Max Distance", 50, 2000, Aimbot.MaxDistance, " studs", function(v) Aimbot.MaxDistance = v end, "Aimbot_MaxDistance")
    toggle(aimPage, "Team Check", "skip players on your own team", true, function(v) Aimbot.TeamCheck = v end, "Aimbot_TeamCheck")
    toggle(aimPage, "Wall Check", "skip players behind cover", true, function(v) Aimbot.WallCheck = v end, "Aimbot_WallCheck")

    section(aimPage, "Aimbot FOV Ring")
    slider(aimPage, "FOV Radius", 20, 800, Aimbot.FOV, "px", function(v) Aimbot.FOV = v end, "Aimbot_FOV")
    colorpicker(aimPage, "FOV Color", Aimbot.FOVColor, function(c) Aimbot.FOVColor = c end, "Aimbot_FOVColor")
    slider(aimPage, "Ring Thickness", 1, 8, Aimbot.Thickness, "px", function(v) Aimbot.Thickness = v end, "Aimbot_Thickness")
    toggle(aimPage, "Show FOV Ring", "draws the target radius on screen", true, function(v) Aimbot.ShowFOV = v end, "Aimbot_ShowFOV")

    section(aimPage, "Aimbot Feel")
    slider(aimPage, "Smoothness", 0, 100, Aimbot.Smooth, "%", function(v) Aimbot.Smooth = v end, "Aimbot_Smooth")
    slider(aimPage, "Prediction", 0, 40, Aimbot.Prediction, "ms", function(v) Aimbot.Prediction = v end, "Aimbot_Prediction")
    toggle(aimPage, "Auto Shoot", "fires the held tool while locked", false, function(v) Aimbot.AutoShoot = v end, "Aimbot_AutoShoot")

    ----------------------------------------------------------------
    -- aimlock UI
    ----------------------------------------------------------------
    section(aimPage, "Aimlock  •  hard lock")
    Aimlock.Toggle = toggle(aimPage, "Enable Aimlock", "arm it, then press your key to grab the nearest target", false,
        function(v) Aimlock:Set(v) end, "Aimlock_Armed")
    local lockStatus = new("TextLabel", {
        Parent = rowBase(aimPage, 30), Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -24, 1, 0),
        BackgroundTransparency = 1, Text = "Status: idle", Font = Enum.Font.Gotham,
        TextSize = 12, TextColor3 = SUBTEXT, TextXAlignment = Enum.TextXAlignment.Left,
    })
    local function setLockStatus(text, color)
        lockStatus.Text = "Status: " .. text
        lockStatus.TextColor3 = color or C("sub")
    end

    function Aimlock:Set(on)
        self.Armed = on and true or false
        if self.Armed then
            setLockStatus("armed  •  " .. tostring(Binds.Aimlock) .. " to lock")
        else
            self.Locked = nil
            pressUp()
            setLockStatus("idle")
        end
    end

    function Aimlock:Key()
        if self.Armed then
            if self.Toggle then self.Toggle(false) else self:Set(false) end
            return
        end
        local part = lockCandidate()
        if not part then
            notify("Aimlock: nothing in FOV", BAD)
            return
        end
        if self.Toggle then self.Toggle(true) else self:Set(true) end
        self.Locked = part
        setLockStatus("locked", GOOD)
    end

    cycle(aimPage, "Target Part", "Head = headshots  |  Torso = body  |  Root = center mass",
        {"Head", "Torso", "Root"}, Aimlock.Part, function(v) Aimlock.Part = v end, "Aimlock_Part")
    slider(aimPage, "Lock FOV", 20, 600, Aimlock.LockFOV, "px", function(v) Aimlock.LockFOV = v end, "Aimlock_LockFOV")
    toggle(aimPage, "Wall Check", "drop the lock while the target is behind cover", false,
        function(v) Aimlock.WallCheck = v end, "Aimlock_WallCheck")
    toggle(aimPage, "No Recoil", "snap the camera instantly instead of smoothing", false,
        function(v) Aimlock.NoRecoil = v end, "Aimlock_NoRecoil")
    slider(aimPage, "Smoothness", 0, 100, Aimlock.Smooth, "%", function(v) Aimlock.Smooth = v end, "Aimlock_Smooth")
    slider(aimPage, "Prediction", 0, 40, Aimlock.Prediction, " ms", function(v) Aimlock.Prediction = v end, "Aimlock_Prediction")

    section(aimPage, "Triggerbot")
    toggle(aimPage, "Triggerbot", "auto-fires when the target is under the cursor", false, function(v)
        Aimlock.Trigger = v
        if not v then pressUp() end
    end, "Aimlock_Trigger")
    slider(aimPage, "Trigger FOV", 4, 100, Aimlock.TriggerFOV, "px", function(v) Aimlock.TriggerFOV = v end, "Aimlock_TriggerFOV")
    slider(aimPage, "Trigger Delay", 10, 300, Aimlock.TriggerDelay, " ms", function(v) Aimlock.TriggerDelay = v end, "Aimlock_TriggerDelay")

    section(aimPage, "Lock Ring")
    toggle(aimPage, "Show Lock Ring", "draws the grab radius around the cursor", true,
        function(v) Aimlock.ShowFOV = v end, "Aimlock_ShowFOV")
    colorpicker(aimPage, "Ring Color", Aimlock.FOVColor, function(c) Aimlock.FOVColor = c end, "Aimlock_FOVColor")
    slider(aimPage, "Ring Thickness", 1, 8, Aimlock.Thickness, "px", function(v) Aimlock.Thickness = v end, "Aimlock_Thickness")

    section(aimPage, "Notes")
    new("TextLabel", {
        Parent = rowBase(aimPage, 84), Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 1, -16),
        BackgroundTransparency = 1, TextWrapped = true,
        Text = "Aimbot is camera-only and draws its ring at screen centre. Aimlock grabs the closest player inside the ring at your cursor - press once to lock, again to drop it. If you run both, the aimlock wins because it is bound after the aimbot. Smoothness 100 is slow and legit-looking, 0 is a hard snap.",
        Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = SUBTEXT,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    RunService:BindToRenderStep("VR1ZZ_Aimlock", Enum.RenderPriority.Camera.Value + 2, function(dt)
        if not gui.Parent then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        local mousePos = UIS:GetMouseLocation()

        lockRing.Visible = Aimlock.Armed and Aimlock.ShowFOV
        if lockRing.Visible then
            lockRing.Position = UDim2.fromOffset(mousePos.X, mousePos.Y)
            lockRing.Size = UDim2.fromOffset(Aimlock.LockFOV * 2, Aimlock.LockFOV * 2)
            lockRingStroke.Color = Aimlock.FOVColor
            lockRingStroke.Thickness = Aimlock.Thickness
        end

        if not Aimlock.Armed or spectating or UIS:GetFocusedTextBox() then
            if not Aimlock.Armed then pressUp() end
            lockRingStroke.Transparency = 0.3
            return
        end

        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then
            if Aimlock.Toggle then Aimlock.Toggle(false) else Aimlock:Set(false) end
            return
        end

        local target = Aimlock.Locked
        if not target or not target.Parent then
            lockRingStroke.Transparency = 0.3
            return
        end
        local targetHum = target.Parent:FindFirstChildOfClass("Humanoid")
        if not targetHum or targetHum.Health <= 0 then
            if Aimlock.Toggle then Aimlock.Toggle(false) else Aimlock:Set(false) end
            return
        end

        if Aimlock.WallCheck and not lockVisible(target) then
            pressUp()
            return
        end

        lockRingStroke.Transparency = 0
        local aimPos = target.Position
        if Aimlock.Prediction > 0 then
            aimPos += target.AssemblyLinearVelocity * (Aimlock.Prediction / 1000)
        end
        local goal = CFrame.lookAt(cam.CFrame.Position, aimPos)
        if Aimlock.NoRecoil then
            cam.CFrame = goal
        else
            local alpha = 1 - math.exp(-dt * (1 + (100 - Aimlock.Smooth) * 0.9))
            cam.CFrame = cam.CFrame:Lerp(goal, math.clamp(alpha, 0, 1))
        end

        if Aimlock.Trigger then
            local sp, on = cam:WorldToViewportPoint(target.Position)
            if on and (Vector2.new(sp.X, sp.Y) - mousePos).Magnitude <= Aimlock.TriggerFOV
                and (tick() - Aimlock.LastClick) >= (Aimlock.TriggerDelay / 1000) then
                Aimlock.LastClick = tick()
                pressDown()
                task.delay(0.03, pressUp)
            end
        else
            pressUp()
        end
    end)

    gui.Destroying:Connect(function()
        Aimbot.Armed, Aimbot.Holding, Aimbot.Target = false, false, nil
        Aimlock.Armed, Aimlock.Locked = false, nil
        if Aimlock.Release then pcall(Aimlock.Release) end
        pcall(function() RunService:UnbindFromRenderStep("VR1ZZ_Aimbot") end)
        pcall(function() RunService:UnbindFromRenderStep("VR1ZZ_Aimlock") end)
    end)
end -- combat scope


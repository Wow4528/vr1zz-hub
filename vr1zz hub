    local track = new("Frame", {
        Parent = row, Position = UDim2.new(0, 12, 0, 34), Size = UDim2.new(1, -24, 0, 5),
        BackgroundColor3 = FIELD, BorderSizePixel = 0,
    }, {corner(3)})
    local fill = new("Frame", {
        Parent = track, Size = UDim2.new((default - min) / (max - min), 0, 1, 0), BorderSizePixel = 0,
        BackgroundColor3 = ACCENT,
    }, {corner(3)})
    new("Frame", {
        Parent = fill, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0, 12, 0, 12), BackgroundColor3 = ACCENT,
    }, {corner(6)})
    local hit = new("TextButton", {
        Parent = track, Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 0.5, -11),
        BackgroundTransparency = 1, Text = "",
    })
    local function apply(v)
        value = math.clamp(math.floor(v + 0.5), min, max)
        fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
        valLbl.Text = value .. suffix
        callback(value)
    end
    bind(hit, track, function(rel) apply(min + (max - min) * rel) end)
    register(key, function() return value end, apply)
    return apply
end

local function colorpicker(page, title, default, callback, key)
    local row = rowBase(page, 80)
    local tl = label(row, title)
    tl.Size = UDim2.new(0.6, 0, 0, 36)
    local h, s, v = default:ToHSV()
    local swatch = new("Frame", {
        Parent = row, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 9),
        Size = UDim2.new(0, 38, 0, 18), BackgroundColor3 = default,
    }, {corner(5), new("UIStroke", {Color = Color3.new(1, 1, 1), Transparency = 0.7})})

    local function strip(y)
        local track = new("Frame", {
            Parent = row, Position = UDim2.new(0, 12, 0, y), Size = UDim2.new(1, -24, 0, 8),
            BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        }, {corner(4)})
        local knob = new("Frame", {
            Parent = track, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.new(0, 12, 0, 12), BackgroundColor3 = Color3.new(1, 1, 1),
        }, {corner(6), new("UIStroke", {Color = Color3.new(0, 0, 0), Thickness = 2})})
        local hit = new("TextButton", {
            Parent = track, Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 0.5, -11),
            BackgroundTransparency = 1, Text = "",
        })
        return track, knob, hit
    end
    local hueTrack, hueKnob, hueHit = strip(40)
    local satTrack, satKnob, satHit = strip(60)
    new("UIGradient", {Parent = hueTrack, Color = ColorSequence.new({
        kp(0, Color3.fromHSV(0, 1, 1)), kp(0.17, Color3.fromHSV(0.17, 1, 1)),
        kp(0.33, Color3.fromHSV(0.33, 1, 1)), kp(0.5, Color3.fromHSV(0.5, 1, 1)),
        kp(0.67, Color3.fromHSV(0.67, 1, 1)), kp(0.83, Color3.fromHSV(0.83, 1, 1)),
        kp(1, Color3.fromHSV(1, 1, 1)),
    })})
    local satGrad = new("UIGradient", {Parent = satTrack})

    local function render()
        local c = Color3.fromHSV(h, s, v)
        swatch.BackgroundColor3 = c
        hueKnob.Position = UDim2.new(h, 0, 0.5, 0)
        satKnob.Position = UDim2.new(s, 0, 0.5, 0)
        satGrad.Color = ColorSequence.new(Color3.fromHSV(h, 0, v), Color3.fromHSV(h, 1, v))
        return c
    end
    render()
    bind(hueHit, hueTrack, function(rel) h = rel; callback(render()) end)
    bind(satHit, satTrack, function(rel) s = rel; callback(render()) end)

    local function set(c)
        h, s, v = c:ToHSV()
        callback(render())
    end
    register(key, function() return Color3.fromHSV(h, s, v) end, set)
    return set
end


local statusLbl = new("TextLabel", {
    Parent = rowBase(configPage, 34), Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -24, 1, 0),
    BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = SUBTEXT,
    TextXAlignment = Enum.TextXAlignment.Left,
    Text = hasFS and "Status: ready" or "Status: this executor has no file support",
})
local function setStatus(text, color, quiet)
    statusLbl.Text = "Status: " .. text
    statusLbl.TextColor3 = color or C("sub")
    if not quiet then notify("Config: " .. text, color) end
end

local function serialize()
    local out = {}
    for key, c in pairs(registry) do
        local val = c.get()
        if typeof(val) == "Color3" then
            val = {r = math.floor(val.R * 255 + 0.5), g = math.floor(val.G * 255 + 0.5), b = math.floor(val.B * 255 + 0.5)}
        end
        out[key] = val
    end
    return out
end
local function deserialize(data)
    -- the named theme must load first so saved custom colors can sit on top of it
    if data.Theme_Name ~= nil and registry.Theme_Name then pcall(registry.Theme_Name.set, data.Theme_Name) end
    for key, c in pairs(registry) do
        local val = data[key]
        if key ~= "Theme_Name" and val ~= nil then
            if type(val) == "table" and val.r then val = Color3.fromRGB(val.r, val.g, val.b) end
            pcall(c.set, val)
        end
    end
end
local function saveConfig(silent)
    if not hasFS then return setStatus("no file support here", BAD) end
    local ok = pcall(function() writefile(FILE, HttpService:JSONEncode(serialize())) end)
    if ok then setStatus("saved ✓", GOOD, silent) else setStatus("save failed", BAD) end
end
local function loadConfig(silent)
    if not hasFS then return setStatus("no file support here", BAD) end
    if not isfile(FILE) then
        if not silent then setStatus("no saved config found", BAD) end
        return
    end
    local ok = pcall(function() deserialize(HttpService:JSONDecode(readfile(FILE))) end)
    if ok then setStatus(silent and "auto-loaded ✓" or "loaded ✓", GOOD) else setStatus("load failed", BAD) end
end
